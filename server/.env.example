PORT=5000

# =========================================================================
# MongoDB Database Configuration
# =========================================================================
# Option 1: MongoDB Atlas (Free Cloud Database - Recommended)
# 1. Create a free M0 cluster at https://www.mongodb.com/atlas
# 2. Add Database User & Password
# 3. In Network Access, whitelist 0.0.0.0/0 (or your IP)
# 4. Paste your connection string below:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/krishdrishti?retryWrites=true&w=majority

# Option 2: Local MongoDB Server (Windows / Mac / Linux)
# MONGODB_URI=mongodb://127.0.0.1:27017/krishdrishti
MONGODB_URI=mongodb://127.0.0.1:27017/krishdrishti

JWT_SECRET=your_jwt_secret_key_change_in_production
AI_SERVICE_URL=http://localhost:8000

# Cloudinary Settings (Optional - Image storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Nodemailer Settings (Optional - OTP email verification)
EMAIL_USER=
EMAIL_PASS=

# AI Chatbot Settings (Optional - Gemini API Key)
GEMINI_API_KEY=
